# Leave empty to run without the backend
VITE_API_URL=http://localhost:7071
# Leave empty, sign-in goes to /common and the user picks
VITE_AZURE_TENANT_ID=
# GitHub sign-in runs in the browser (PKCE); the backend only exchanges the code for a token.
# Its client secret lives in the Function App as GITHUB_OAUTH_CLIENT_SECRET, never here.
VITE_GITHUB_CLIENT_ID=
# TODO: rename to zeninstaller SPA client id
VITE_AZURE_CLIENT_ID=86bfe2a0-093f-4e3c-ac79-0ad2a500b815
VITE_APPINSIGHTS_CONNECTION_STRING=
# GitHub personal access token for local development testing
GITHUB_TOKEN=
